{
  "name": "viewpoint",
  "version": "0.1.0",
  "description": "Explore GitHub repositories through architecture diagrams and file connection maps.",
  "type": "module",
  "main": "dist/web-server.js",
  "scripts": {
    "build": "tsc --project tsconfig.json && next build --webpack",
    "lint": "eslint src app --ext .ts,.tsx",
    "test": "vitest run",
    "dev": "tsx watch src/web-server.ts --dev",
    "start": "node dist/web-server.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sahil-sharma-50/ViewPoint.git"
  },
  "keywords": [
    "typescript",
    "static-analysis",
    "architecture-diagrams"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sahil-sharma-50/ViewPoint/issues"
  },
  "homepage": "https://github.com/sahil-sharma-50/ViewPoint#readme",
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@vercel/blob": "^2.8.0",
    "express": "^5.2.1",
    "fs-extra": "^11.4.1",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tar": "^7.5.22",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=20.9.0"
  }
